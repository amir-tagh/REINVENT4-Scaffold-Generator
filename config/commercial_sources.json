{
    "schema_version": "1.0",
    "provider": "SwissSimilarity",
    "base_url": "https://swisssimilarity.ch:1234",
    "screening": {
        "method": "ECFP",
        "mode": "both",
        "minimum_analog_similarity": 0.5,
        "maximum_analogs_per_library": 20,
        "preserve_stereochemistry": true,
        "verify_molecular_identity": true
    },
    "api": {
        "request_timeout": 60,
        "poll_interval": 15,
        "maximum_wait": 900,
        "request_interval": 3,
        "parallel_jobs": 1,
        "allow_remote_submission": false,
        "maximum_new_jobs_per_run": 1
    },
    "cache": {
        "enabled": true,
        "database": "databases/commercial/screening_cache.sqlite",
        "reuse_completed": true,
        "resume_sessions": true,
        "refresh": false
    },
